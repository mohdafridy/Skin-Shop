# Copy this file to .env.local and fill in real values as each piece of
# infrastructure is set up. Nothing here is required for the site to run —
# without these, checkout, coupons, and newsletter signup all degrade to
# honest "not connected yet" responses instead of erroring.

# Postgres connection string (e.g. from Supabase, Neon, Railway, or your
# own instance). Required for /api/checkout, /api/coupons/validate,
# /api/newsletter, and the admin routes to do anything.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/the_skin_shop?schema=public"

# Used to build the Stripe success/cancel redirect URLs. Set to your real
# domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# From your Stripe dashboard (test mode keys while developing). Until both
# of these are set, checkout will always show "Payment isn't connected yet"
# rather than attempting a real charge.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Lowercase ISO currency code Stripe expects. The site displays prices in
# INR everywhere already; only change this if that changes.
STORE_CURRENCY="inr"

# A long random secret you generate yourself — required in the
# `x-admin-key` header to use the /api/admin/* routes. Replace the
# ADMIN_API_KEY guard with real staff authentication before relying on
# these routes in production.
ADMIN_API_KEY="replace-with-a-long-random-secret"
