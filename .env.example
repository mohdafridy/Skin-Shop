# Copy this file to .env.local and fill in real values as each piece of
# infrastructure is set up. Nothing here is required for the site to run —
# without these, checkout, coupons, and newsletter signup all degrade to
# honest "not connected yet" responses instead of erroring.

# Postgres connection string (e.g. from Supabase, Neon, Railway, or your
# own instance). Required for /api/checkout, /api/coupons/validate,
# /api/newsletter, and the admin routes to do anything.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/the_skin_shop?schema=public"

# Set to your real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# From your Razorpay dashboard (test mode keys while developing). Until
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are both set, checkout always
# shows "Payment isn't connected yet" rather than attempting a real charge.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
# From Razorpay Dashboard -> Account & Settings -> Webhooks, after you add
# the webhook below. Required for /api/webhooks/razorpay to accept events.
RAZORPAY_WEBHOOK_SECRET="..."
# Public checkout key exposed to the browser to open Razorpay Checkout.
# Same value as RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Uppercase ISO currency code, used for both display and the amount sent to
# Razorpay. The site displays prices in INR everywhere already; only change
# this if that changes.
STORE_CURRENCY="INR"

# A long random secret you generate yourself. Required in the
# `x-admin-key` header to use the /api/admin/* routes directly, and it's
# also the password for the /admin dashboard (Orders → fulfilment, refunds).
# Replace this shared-key guard with real staff authentication before
# relying on it in production.
ADMIN_API_KEY="replace-with-a-long-random-secret"
